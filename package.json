{
  "name": "legal-terminal",
  "version": "0.1.19",
  "description": "대한민국 송무 변호사를 위한 AI 통합 작업환경 — Claude Code + 준비서면 에디터 + 전자소송기록 뷰어 + 사건 대시보드 + 원격(SSH) 작업",
  "main": "./out/main/index.js",
  "author": "lawpid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jurisupport/legal-terminal.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:node-pty": "node scripts/verify-node-pty-binary.cjs",
    "verify:node-pty:win": "node scripts/verify-node-pty-binary.cjs --platform win32 --arch x64",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && npm run verify:node-pty:win && electron-builder --win"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.7",
    "hwp.js": "^0.0.3",
    "marked": "^14.1.4",
    "pdfjs-dist": "^4.10.38",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.3"
  }
}
