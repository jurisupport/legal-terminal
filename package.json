{
  "name": "legal-terminal",
  "version": "0.1.209",
  "description": "대한민국 송무 변호사를 위한 AI 통합 작업환경 — Claude Code + 준비서면 에디터 + 전자소송기록 뷰어 + 사건 대시보드 + 원격(SSH) 작업",
  "main": "./out/main/index.js",
  "author": "lawpid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jurisupport/legal-terminal.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:case-store": "node --experimental-strip-types --no-warnings scripts/verify-case-store.mjs",
    "verify:case-folder-safety": "node --experimental-strip-types --no-warnings scripts/verify-case-folder-safety.mjs",
    "verify:case-activity": "node --experimental-strip-types --no-warnings scripts/verify-case-activity.mjs",
    "verify:session-sync": "node --experimental-strip-types --no-warnings scripts/verify-session-sync.mjs",
    "verify:workspace-sessions": "node --experimental-strip-types --no-warnings scripts/verify-workspace-sessions.mjs",
    "verify:sync-unicode": "node --experimental-strip-types --no-warnings scripts/verify-sync-unicode.mjs",
    "verify:ssh-pool": "node --experimental-strip-types --no-warnings scripts/verify-ssh-connection-pool.mjs",
    "verify:case-sync": "node --experimental-strip-types --no-warnings scripts/verify-case-sync.mjs",
    "verify:drag-guard": "node --experimental-strip-types --no-warnings scripts/verify-drag-guard.mjs",
    "verify:multi-download": "node scripts/verify-multi-download.mjs",
    "verify:agent-rate-limits": "node --experimental-strip-types --no-warnings scripts/verify-agent-rate-limits.mjs",
    "verify:agent-token-usage": "node --experimental-strip-types --no-warnings scripts/verify-agent-token-usage.mjs",
    "verify:agent-progress": "node --experimental-strip-types --no-warnings scripts/verify-agent-progress.mjs",
    "verify:agent-dialog": "node scripts/verify-agent-dialog.mjs",
    "verify:agent-model-display": "node --experimental-strip-types --no-warnings scripts/verify-agent-model-display.mjs",
    "verify:agent-account-switch": "node scripts/verify-agent-account-switch.mjs",
    "verify:agent-auth-queue": "node scripts/verify-agent-auth-queue.mjs",
    "verify:agent-case-context": "node --experimental-strip-types --no-warnings scripts/verify-agent-case-context.mjs",
    "verify:agent-session-search": "node --experimental-strip-types --no-warnings scripts/verify-agent-session-search.mjs",
    "verify:agent-quote": "node --experimental-strip-types --no-warnings scripts/verify-agent-quote.mjs",
    "verify:agent-slash-autocomplete": "node --experimental-strip-types --no-warnings scripts/verify-agent-slash-autocomplete.mjs",
    "verify:ssh-options": "node --experimental-strip-types --no-warnings scripts/verify-ssh-options.mjs",
    "verify:remote-quick-start": "node --experimental-strip-types --no-warnings scripts/verify-remote-quick-start.mjs",
    "verify:agent-rate-limit-labels": "node --experimental-strip-types --no-warnings scripts/verify-agent-rate-limit-labels.mjs",
    "verify:terminal-status": "node --experimental-strip-types --no-warnings scripts/verify-terminal-status.mjs",
    "verify:renderer-recovery": "electron-vite build && node scripts/verify-renderer-recovery.mjs",
    "verify:skill-install": "node --experimental-strip-types --no-warnings scripts/verify-skill-install.mjs",
    "verify:hearing-ime": "node --experimental-strip-types --no-warnings scripts/verify-hearing-ime.mjs",
    "verify:hearing-tab": "electron-vite build && node scripts/verify-hearing-tab.mjs",
    "verify:slash-commands": "electron-vite build && node scripts/verify-slash-commands.mjs",
    "verify:md-compat": "node --experimental-strip-types --no-warnings scripts/verify-md-compat.mjs",
    "verify:record-outline": "node --experimental-strip-types --no-warnings scripts/verify-record-outline.mjs",
    "verify:pdf-layout": "node scripts/verify-pdf-layout.mjs",
    "verify:hwp-text": "node --experimental-strip-types --no-warnings scripts/verify-hwp-text.mjs",
    "verify:hwpx-court": "node --experimental-strip-types --no-warnings scripts/verify-hwpx-court-template.mjs",
    "verify:node-pty": "node scripts/verify-node-pty-binary.cjs",
    "verify:node-pty:win": "node scripts/verify-node-pty-binary.cjs --platform win32 --arch x64",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && npm run verify:node-pty:win && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.7",
    "highlight.js": "^11.11.1",
    "hwp.js": "^0.0.3",
    "marked": "^14.1.4",
    "pdfjs-dist": "^4.10.38",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.9.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.3"
  }
}
